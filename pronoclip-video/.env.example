# ── pronoclip-video — variables d'environnement ─────────────────────────────
# Copier ce fichier en `.env` et renseigner les valeurs.
# `.env` n'est JAMAIS versionné (voir .gitignore).
# Aucun secret ne doit vivre dans pronoclip.config.json ni dans les skills.

# ── RapidoCMS (publication + génération d'images via MCP) ────────────────────
# Identifiant société RapidoCMS (remplace l'ancien company_id codé en dur).
RAPIDOCMS_COMPANY_ID=
# URL du serveur MCP RapidoCMS (jamais en dur dans le code).
RAPIDOCMS_MCP_URL=

# ── RapidoRH (routine par journée de matchs via MCP) ─────────────────────────
# URL du serveur MCP RapidoRH.
RAPIDORH_MCP_URL=

# ── n8n — matchs du jour ─────────────────────────────────────────────────────
# Webhook appelé en POST avec un corps `{}` avant toute génération vidéo.
# Renvoie les matchs du jour ; le match à traiter est choisi par l'utilisateur.
# La prédiction reste locale (core/prediction.ts) — n8n ne fournit que le match.
N8N_FIXTURES_WEBHOOK=

# ── HyperFrames (rendu vidéo) ────────────────────────────────────────────────
# Rendu par défaut = CLI local (gratuit) : aucune variable requise.
# URL du MCP HyperFrames payant, uniquement pour le rendu premium (opt-in).
HYPERFRAMES_MCP_URL=

# ── Voix off / présentateur (optionnels, payants) ────────────────────────────
# Requis seulement si voice.provider = "elevenlabs" dans pronoclip.config.json.
ELEVENLABS_API_KEY=
# Requis seulement pour le présentateur animé HeyGen (opt-in premium).
HEYGEN_API_KEY=
FAL_KEY=
# ── Génération de portraits manquants (facultatif) ───────────────────────────
# Sources du semis automatique. Le portrait est produit par `images/edits` avec DEUX
# références : le visage du joueur puis le maillot domicile. Sans ces dossiers, un
# joueur absent de la bibliothèque reste absent — il n'est jamais inventé.
# Dossier des portraits produits, organisé `<Équipe>/<Nom complet>.png`.
PRONOCLIP_PORTRAITS_DIR=
# Visages de référence, `<Équipe>/<Nom_Complet>(Poste).png`. Facultatif : à défaut,
# le visage est téléchargé depuis l'URL CDN portée par le CSV d'effectif.
PRONOCLIP_FACES_DIR=
# Maillots, `<Équipe>/<pays>-2026-home-kit.jpg`.
PRONOCLIP_KITS_DIR=
# Effectifs sources, `<team_code>_squad.csv` (colonnes Full Name, Position, Image CDN URL).
PRONOCLIP_SQUADS_CSV_DIR=

# ── Publication RapidoCMS (compte cible) ─────────────────────────────────────
# Identifiant du compte connecté (page_id / profile_id / open_id) — JAMAIS en dur
# dans le code. Sans lui, la composition du plan de publication est refusée.
RAPIDOCMS_ACCOUNT_ID=
# Réseau par défaut : instagram | facebook | linkedin | tiktok. Défaut instagram.
RAPIDOCMS_SOCIAL_TYPE=
